    "eslint-plugin-react-hooks": "^4.6.2",
    "i18next-cli": "^1.85.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "yarn@4.18.1"
